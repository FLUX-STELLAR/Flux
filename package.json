{
  "name": "flux-settlement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "tsx backend/src/index.ts",
    "build": "tsc --noEmit && vite build --config frontend/vite.config.ts",
    "start": "NODE_ENV=production tsx backend/src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test backend/tests/*.test.ts",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write frontend backend docs README.md *.json .github",
    "format:check": "prettier --check frontend backend docs README.md *.json .github"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "express": "^5.2.1",
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
