# Local development only. The default rail never sends real funds.
PORT=4337
FLUX_DB_PATH=backend/data/flux.sqlite
FLUX_MODE=sandbox
# Optional fixed secrets. Without these, random local secrets are persisted in data/.
# FLUX_API_TOKEN=
# FLUX_WEBHOOK_SECRET=
# Optional operator-controlled webhook destination. Must be https, no redirects.
# FLUX_WEBHOOK_URL=
